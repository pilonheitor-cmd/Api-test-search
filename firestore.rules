rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDossierString(val) {
      return val is string && val.size() <= 600;
    }

    function isValidDossier(d) {
      return d is map &&
             d.keys().hasAll([
               'nome', 'cpf', 'nascimento', 'score', 'nomeMae', 'nomePai',
               'sexo', 'estadoCivil', 'escolaridade', 'rendaMensal', 'rg',
               'enderecoPrincipal', 'enderecoSecundario', 'telefone', 'email',
               'profissao', 'veiculo', 'parentes', 'vizinhos'
             ]) &&
             d.keys().hasOnly([
               'nome', 'cpf', 'nascimento', 'score', 'nomeMae', 'nomePai',
               'sexo', 'estadoCivil', 'escolaridade', 'rendaMensal', 'rg',
               'enderecoPrincipal', 'enderecoSecundario', 'telefone', 'email',
               'profissao', 'veiculo', 'parentes', 'vizinhos'
             ]) &&
             isValidDossierString(d.nome) &&
             isValidDossierString(d.cpf) &&
             isValidDossierString(d.nascimento) &&
             isValidDossierString(d.score) &&
             isValidDossierString(d.nomeMae) &&
             isValidDossierString(d.nomePai) &&
             isValidDossierString(d.sexo) &&
             isValidDossierString(d.estadoCivil) &&
             isValidDossierString(d.escolaridade) &&
             isValidDossierString(d.rendaMensal) &&
             isValidDossierString(d.rg) &&
             isValidDossierString(d.enderecoPrincipal) &&
             isValidDossierString(d.enderecoSecundario) &&
             isValidDossierString(d.telefone) &&
             isValidDossierString(d.email) &&
             isValidDossierString(d.profissao) &&
             isValidDossierString(d.veiculo) &&
             isValidDossierString(d.parentes) &&
             isValidDossierString(d.vizinhos);
    }

    function isValidConsulta(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.searchMode in ['NAME', 'CPF', 'COMBINED'] &&
             data.queryName is string && data.queryName.size() <= 160 &&
             data.queryCpf is string && data.queryCpf.size() <= 25 &&
             data.queryPhone is string && data.queryPhone.size() <= 35 &&
             data.cpfValid is bool &&
             data.cpfRegion is string && data.cpfRegion.size() <= 160 &&
             data.dddRegion is string && data.dddRegion.size() <= 240 &&
             data.ibgeFrequency is int && data.ibgeFrequency >= 0 &&
             data.summary is string && data.summary.size() <= 6000 &&
             data.thinkingAnalysis is string && data.thinkingAnalysis.size() <= 12000 &&
             isValidDossier(data.dossier) &&
             data.sourceEntries is list && data.sourceEntries.size() <= 15 &&
             (data.sourceEntries.size() == 0 || (data.sourceEntries[0] is string && data.sourceEntries[0].size() <= 600)) &&
             data.pinned is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /consultas/{consultaId} {
        allow get: if isOwner(userId) && isValidId(consultaId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(consultaId) &&
                         incoming().keys().hasAll([
                           'userId', 'searchMode', 'queryName', 'queryCpf', 'queryPhone',
                           'cpfValid', 'cpfRegion', 'dddRegion', 'ibgeFrequency',
                           'summary', 'thinkingAnalysis', 'dossier', 'sourceEntries',
                           'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'searchMode', 'queryName', 'queryCpf', 'queryPhone',
                           'cpfValid', 'cpfRegion', 'dddRegion', 'ibgeFrequency',
                           'summary', 'thinkingAnalysis', 'dossier', 'sourceEntries',
                           'pinned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt <= request.time &&
                         isValidConsulta(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(consultaId) &&
                         isValidConsulta(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['thinkingAnalysis', 'summary', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(consultaId);
      }
    }
  }
}
